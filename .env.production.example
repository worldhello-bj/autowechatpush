# Production Environment Configuration
# Copy this file to .env.production and configure for your deployment

# Backend API base URL (for production deployment)
# Examples:
#   微信云托管: https://your-service.ap-shanghai.run.wxcloudrun.com/api/v1
#   自建服务器: https://api.your-domain.com/api/v1
#   同域部署: /api/v1 (使用 Nginx 代理)
VITE_API_BASE=/api/v1
