<!--pages/index/index.wxml-->
<!-- 主编辑器页面 - AI文章生成 -->

<view class="container">
  <!-- 顶部状态栏 -->
  <view class="header-card card">
    <view class="flex items-center justify-between">
      <view>
        <text class="title-md">AI文章生成器</text>
        <view class="flex items-center gap-sm mt-sm">
          <view class="status-dot {{aiProvider === 'google' ? 'bg-green' : aiProvider === 'deepseek' ? 'bg-blue' : 'bg-purple'}}"></view>
          <text class="text-muted">{{providerName}}</text>
        </view>
      </view>
      <view class="flex gap-sm">
        <button class="icon-btn" bindtap="goToDrafts">
          <text class="icon-text">📝</text>
        </button>
        <button class="icon-btn" bindtap="goToSettings">
          <text class="icon-text">⚙️</text>
        </button>
        <button class="icon-btn" bindtap="saveDraft">
          <text class="icon-text">💾</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 模式切换 -->
  <view class="mode-switcher card">
    <view class="flex">
      <view 
        class="mode-btn {{!isFormattingMode ? 'active' : ''}}" 
        bindtap="switchMode" 
        data-mode="create"
      >
        <text class="mode-icon">✨</text>
        <text>创建新文章</text>
      </view>
      <view 
        class="mode-btn {{isFormattingMode ? 'active' : ''}}" 
        bindtap="switchMode" 
        data-mode="format"
      >
        <text class="mode-icon">🎨</text>
        <text>格式化文本</text>
      </view>
    </view>
  </view>

  <!-- 输入区域 -->
  <view class="input-section card">
    <view class="label">{{isFormattingMode ? '粘贴要格式化的文本' : '主题/提示词'}}</view>
    <textarea 
      class="textarea-field"
      placeholder="{{isFormattingMode ? '在此粘贴您的文章内容，AI将为其添加精美排版...' : '例如：写一篇关于秋季京都旅行的指南...'}}"
      value="{{topic}}"
      bindinput="onTopicInput"
      maxlength="2000"
    />
    
    <!-- 选项开关 -->
    <view class="options-row flex flex-wrap gap-sm mt-md">
      <!-- 网络搜索 -->
      <view 
        class="option-chip {{useSearch && aiProvider !== 'deepseek' && !isFormattingMode ? 'active' : ''}} {{aiProvider === 'deepseek' || isFormattingMode ? 'disabled' : ''}}"
        bindtap="toggleSearch"
      >
        <text class="option-icon">🔍</text>
        <text>网络搜索</text>
      </view>
      
      <!-- 双AI模式 -->
      <view 
        class="option-chip {{useDualAI && aiProvider !== 'google' && !isFormattingMode ? 'active dual-ai' : ''}} {{aiProvider === 'google' || isFormattingMode ? 'disabled' : ''}}"
        bindtap="toggleDualAI"
        data-tooltip="双AI模式：分两次调用，先生成内容后美化设计"
      >
        <text class="option-icon">🧠</text>
        <text>双AI模式</text>
        <text wx:if="{{useDualAI && aiProvider !== 'google'}}" class="badge-mini">两次调用</text>
      </view>
    </view>
    
    <!-- 双AI模式说明 -->
    <view wx:if="{{useDualAI && aiProvider !== 'google' && !isFormattingMode}}" class="dual-ai-info">
      <text class="info-icon">✨</text>
      <view class="info-content">
        <text class="info-title">双AI模式已启用（两次调用）</text>
        <text class="info-desc">第一次：内容AI专注创作 → 第二次：设计AI优化排版 → 节省上下文，更加专精</text>
      </view>
    </view>
  </view>

  <!-- 图片上传 -->
  <view class="upload-section card" bindtap="chooseImage">
    <view wx:if="{{uploadedImage}}" class="uploaded-preview">
      <image src="{{uploadedImage}}" mode="aspectFit" class="preview-image"/>
      <view class="preview-status {{analyzingImage ? 'analyzing' : 'ready'}}">
        {{analyzingImage ? '分析中...' : (aiProvider !== 'deepseek' ? '已分析' : '仅作封面')}}
      </view>
      <view class="remove-image" catchtap="removeImage">×</view>
    </view>
    <view wx:else class="upload-placeholder">
      <text class="upload-icon">📷</text>
      <text class="upload-text">上传图片（封面）</text>
      <text wx:if="{{aiProvider !== 'deepseek'}}" class="upload-hint">+ {{providerName}} 图像分析</text>
    </view>
  </view>

  <!-- 生成按钮 -->
  <button 
    class="generate-btn {{useDualAI && aiProvider !== 'google' && !isFormattingMode ? 'dual-ai-btn' : 'primary-btn'}}"
    bindtap="generateArticle"
    disabled="{{loading || analyzingImage}}"
  >
    <view wx:if="{{loading}}" class="loading-spinner"></view>
    <text wx:else class="btn-icon">{{isFormattingMode ? '🎨' : (useDualAI ? '🧠' : '✨')}}</text>
    <text>{{loading ? (useDualAI && !isFormattingMode ? '双AI处理中...' : (isFormattingMode ? '格式化中...' : '生成中...')) : (isFormattingMode ? '格式化文章' : (useDualAI && aiProvider !== 'google' ? '双AI生成' : '生成文章'))}}</text>
  </button>

  <!-- 来源引用 -->
  <view wx:if="{{sources.length > 0}}" class="sources-card card">
    <view class="sources-header">
      <text class="sources-title">📚 参考来源</text>
    </view>
    <view class="sources-list">
      <view wx:for="{{sources}}" wx:key="uri" class="source-item" bindtap="openSource" data-url="{{item.uri}}">
        <text class="source-bullet">•</text>
        <text class="source-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- 文章预览 -->
  <view wx:if="{{articleHtml}}" class="preview-section">
    <view class="preview-header flex items-center justify-between">
      <text class="title-sm">📱 文章预览</text>
      <view class="preview-actions flex gap-sm">
        <button class="action-btn" bindtap="copyContent">复制</button>
        <button class="action-btn primary" bindtap="publishToWeChat">发布</button>
      </view>
    </view>
    
    <!-- 模拟手机预览 -->
    <view class="phone-mockup">
      <view class="phone-notch"></view>
      <view class="phone-screen">
        <view class="article-header">
          <text class="article-title">{{articleTitle}}</text>
          <view class="article-meta">
            <text class="article-author">AI助手</text>
            <text class="article-date">{{currentDate}}</text>
          </view>
        </view>
        <rich-text class="article-content" nodes="{{articleHtml}}"></rich-text>
      </view>
    </view>
  </view>

  <!-- 底部工具栏 -->
  <view class="bottom-toolbar card">
    <view class="toolbar-btn" bindtap="openMaterialLibrary">
      <text class="toolbar-icon">📁</text>
      <text>素材库</text>
    </view>
    <view class="toolbar-btn" bindtap="openAITools">
      <text class="toolbar-icon">🤖</text>
      <text>AI工具</text>
    </view>
    <view class="toolbar-btn" bindtap="openTemplates">
      <text class="toolbar-icon">🎨</text>
      <text>模板库</text>
    </view>
  </view>
</view>

<!-- 素材库弹窗 -->
<view wx:if="{{showMaterialLibrary}}" class="modal-mask" bindtap="closeMaterialLibrary">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">📁 素材库</text>
      <view class="modal-close" bindtap="closeMaterialLibrary">×</view>
    </view>
    <view class="modal-body">
      <!-- 标签页 -->
      <view class="tab-bar">
        <view 
          class="tab-item {{materialTab === 'images' ? 'active' : ''}}" 
          bindtap="switchMaterialTab" 
          data-tab="images"
        >图片</view>
        <view 
          class="tab-item {{materialTab === 'text' ? 'active' : ''}}" 
          bindtap="switchMaterialTab" 
          data-tab="text"
        >文案</view>
        <view 
          class="tab-item {{materialTab === 'svg' ? 'active' : ''}}" 
          bindtap="switchMaterialTab" 
          data-tab="svg"
        >SVG</view>
      </view>
      
      <!-- 素材列表 -->
      <scroll-view scroll-y class="material-list">
        <view wx:if="{{materialTab === 'images'}}" class="image-grid">
          <view class="add-material" bindtap="uploadMaterial">
            <text class="add-icon">+</text>
            <text class="add-text">上传</text>
          </view>
          <view 
            wx:for="{{materials.images}}" 
            wx:key="id" 
            class="material-item"
            bindtap="insertMaterial"
            data-type="image"
            data-content="{{item.url}}"
          >
            <image src="{{item.url}}" mode="aspectFill" class="material-thumb"/>
          </view>
        </view>
        
        <view wx:if="{{materialTab === 'text'}}" class="text-list">
          <view 
            wx:for="{{presetTexts}}" 
            wx:key="id" 
            class="text-item"
            bindtap="insertMaterial"
            data-type="text"
            data-content="{{item.content}}"
          >
            <text class="text-category">{{item.category}}</text>
            <text class="text-content">{{item.content}}</text>
          </view>
        </view>
        
        <view wx:if="{{materialTab === 'svg'}}" class="svg-grid">
          <view 
            wx:for="{{presetSvgs}}" 
            wx:key="id" 
            class="svg-item"
            bindtap="insertMaterial"
            data-type="svg"
            data-content="{{item.svg}}"
          >
            <rich-text nodes="{{item.svg}}" class="svg-preview"/>
            <text class="svg-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

<!-- AI工具弹窗 -->
<view wx:if="{{showAITools}}" class="modal-mask" bindtap="closeAITools">
  <view class="modal-content large" catchtap="">
    <view class="modal-header">
      <text class="modal-title">🤖 AI智能工具</text>
      <view class="modal-close" bindtap="closeAITools">×</view>
    </view>
    <view class="modal-body">
      <scroll-view scroll-y class="ai-tools-list">
        <!-- 标题生成 -->
        <view class="ai-tool-card" bindtap="generateTitles">
          <view class="tool-icon">📝</view>
          <view class="tool-info">
            <text class="tool-name">标题建议</text>
            <text class="tool-desc">生成多个备选标题</text>
          </view>
          <text class="tool-arrow">›</text>
        </view>
        
        <!-- 摘要生成 -->
        <view class="ai-tool-card" bindtap="generateSummary">
          <view class="tool-icon">📋</view>
          <view class="tool-info">
            <text class="tool-name">生成摘要</text>
            <text class="tool-desc">自动生成文章摘要</text>
          </view>
          <text class="tool-arrow">›</text>
        </view>
        
        <!-- 关键词提取 -->
        <view class="ai-tool-card" bindtap="extractKeywords">
          <view class="tool-icon">🏷️</view>
          <view class="tool-info">
            <text class="tool-name">关键词提取</text>
            <text class="tool-desc">提取文章核心关键词</text>
          </view>
          <text class="tool-arrow">›</text>
        </view>
        
        <!-- 内容润色 -->
        <view class="ai-tool-card" bindtap="polishContent">
          <view class="tool-icon">✨</view>
          <view class="tool-info">
            <text class="tool-name">内容润色</text>
            <text class="tool-desc">优化文章表达</text>
          </view>
          <text class="tool-arrow">›</text>
        </view>
        
        <!-- 翻译 -->
        <view class="ai-tool-card" bindtap="translateContent">
          <view class="tool-icon">🌐</view>
          <view class="tool-info">
            <text class="tool-name">中英互译</text>
            <text class="tool-desc">翻译文章内容</text>
          </view>
          <text class="tool-arrow">›</text>
        </view>
        
        <!-- 扩写 -->
        <view class="ai-tool-card" bindtap="expandContent">
          <view class="tool-icon">📖</view>
          <view class="tool-info">
            <text class="tool-name">内容扩写</text>
            <text class="tool-desc">丰富文章内容</text>
          </view>
          <text class="tool-arrow">›</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
