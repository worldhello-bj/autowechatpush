<!--pages/settings/settings.wxml-->
<!-- 设置页面 -->

<view class="container">
  <!-- 用户信息 -->
  <view class="user-card card">
    <view class="user-info" wx:if="{{userInfo}}">
      <view class="user-avatar">
        <text class="avatar-text">{{userInfo.name[0] || 'U'}}</text>
      </view>
      <view class="user-details">
        <text class="user-name">{{userInfo.name}}</text>
        <text class="user-email">{{userInfo.email}}</text>
        <view wx:if="{{userInfo.role === 'admin'}}" class="user-role">
          <text class="role-badge">管理员</text>
        </view>
      </view>
      <view class="user-quota">
        <text class="quota-label">配额</text>
        <text class="quota-value">{{userInfo.quota}}</text>
      </view>
    </view>
    <view class="user-info" wx:else>
      <view class="user-avatar guest">
        <text class="avatar-text">?</text>
      </view>
      <view class="user-details">
        <text class="user-name">未登录</text>
        <button class="login-btn" bindtap="goToLogin">立即登录</button>
      </view>
    </view>
  </view>

  <!-- AI 模型设置 -->
  <view class="section-card card">
    <view class="section-header">
      <text class="section-icon">🤖</text>
      <text class="section-title">AI 模型设置</text>
    </view>
    
    <view class="setting-item">
      <text class="setting-label">AI 提供商</text>
    </view>
    
    <view class="provider-list">
      <view 
        class="provider-item {{aiProvider === 'google' ? 'active' : ''}}"
        bindtap="selectProvider"
        data-provider="google"
      >
        <view class="provider-radio {{aiProvider === 'google' ? 'checked' : ''}}"></view>
        <view class="provider-info">
          <text class="provider-name">Google Gemini</text>
          <text class="provider-desc">搜索增强、图像分析、TTS</text>
        </view>
      </view>
      
      <view 
        class="provider-item {{aiProvider === 'deepseek' ? 'active' : ''}}"
        bindtap="selectProvider"
        data-provider="deepseek"
      >
        <view class="provider-radio {{aiProvider === 'deepseek' ? 'checked' : ''}}"></view>
        <view class="provider-info">
          <text class="provider-name">DeepSeek</text>
          <text class="provider-desc">文本生成，支持思考模式</text>
        </view>
      </view>
      
      <view 
        class="provider-item {{aiProvider === 'qwen' ? 'active' : ''}}"
        bindtap="selectProvider"
        data-provider="qwen"
      >
        <view class="provider-radio {{aiProvider === 'qwen' ? 'checked' : ''}}"></view>
        <view class="provider-info">
          <text class="provider-name">Qwen (通义千问)</text>
          <text class="provider-desc">搜索增强、图像分析、TTS</text>
        </view>
      </view>
    </view>
  </view>

  <!-- API 密钥设置 -->
  <view class="section-card card">
    <view class="section-header">
      <text class="section-icon">🔑</text>
      <text class="section-title">API 密钥</text>
    </view>
    
    <!-- Google API Key -->
    <view wx:if="{{aiProvider === 'google'}}" class="key-input-group">
      <text class="key-label">Google Gemini API Key</text>
      <view class="key-input-wrapper">
        <input 
          class="key-input" 
          type="{{showGoogleKey ? 'text' : 'password'}}"
          placeholder="AIza..."
          value="{{googleKey}}"
          bindinput="onGoogleKeyInput"
        />
        <view class="key-toggle" bindtap="toggleGoogleKey">
          <text>{{showGoogleKey ? '🙈' : '👁'}}</text>
        </view>
      </view>
      <text class="key-hint">从 Google AI Studio 获取</text>
    </view>
    
    <!-- DeepSeek API Key -->
    <view wx:if="{{aiProvider === 'deepseek'}}" class="key-input-group">
      <text class="key-label">DeepSeek API Key</text>
      <view class="key-input-wrapper">
        <input 
          class="key-input" 
          type="{{showDeepSeekKey ? 'text' : 'password'}}"
          placeholder="sk-..."
          value="{{deepSeekKey}}"
          bindinput="onDeepSeekKeyInput"
        />
        <view class="key-toggle" bindtap="toggleDeepSeekKey">
          <text>{{showDeepSeekKey ? '🙈' : '👁'}}</text>
        </view>
      </view>
      <text class="key-hint">从 DeepSeek 平台获取</text>
      
      <!-- 思考模式开关 -->
      <view class="toggle-setting">
        <view class="toggle-info">
          <text class="toggle-name">思考模式 (Thinking Mode)</text>
          <text class="toggle-desc">启用后，AI将进行深度思考</text>
        </view>
        <switch 
          checked="{{deepSeekThinkingMode}}" 
          bindchange="toggleThinkingMode"
          color="#3498db"
        />
      </view>
    </view>
    
    <!-- DashScope API Key -->
    <view wx:if="{{aiProvider === 'qwen'}}" class="key-input-group">
      <text class="key-label">DashScope API Key</text>
      <view class="key-input-wrapper">
        <input 
          class="key-input" 
          type="{{showDashScopeKey ? 'text' : 'password'}}"
          placeholder="sk-..."
          value="{{dashScopeKey}}"
          bindinput="onDashScopeKeyInput"
        />
        <view class="key-toggle" bindtap="toggleDashScopeKey">
          <text>{{showDashScopeKey ? '🙈' : '👁'}}</text>
        </view>
      </view>
      <text class="key-hint">从阿里云 DashScope 获取</text>
    </view>
    
    <button class="save-btn" bindtap="saveSettings">保存设置</button>
  </view>

  <!-- 后端服务配置 -->
  <view class="section-card card">
    <view class="section-header">
      <text class="section-icon">🌐</text>
      <text class="section-title">后端服务</text>
    </view>
    
    <view class="key-input-group">
      <text class="key-label">API 基础地址</text>
      <input 
        class="input-field" 
        placeholder="https://your-backend.com/api/v1"
        value="{{apiBaseUrl}}"
        bindinput="onApiUrlInput"
      />
      <text class="key-hint">后端服务API地址，用于AI生成和用户认证</text>
    </view>
    
    <button class="test-btn" bindtap="testConnection">测试连接</button>
  </view>

  <!-- 微信公众号配置 -->
  <view class="section-card card">
    <view class="section-header">
      <text class="section-icon">📱</text>
      <text class="section-title">微信公众号</text>
    </view>
    
    <view class="key-input-group">
      <text class="key-label">AppID</text>
      <input 
        class="input-field" 
        placeholder="wx..."
        value="{{wechatAppId}}"
        bindinput="onWechatAppIdInput"
      />
    </view>
    
    <view class="key-input-group">
      <text class="key-label">AppSecret</text>
      <view class="key-input-wrapper">
        <input 
          class="key-input" 
          type="{{showAppSecret ? 'text' : 'password'}}"
          placeholder="请输入AppSecret"
          value="{{wechatAppSecret}}"
          bindinput="onWechatAppSecretInput"
        />
        <view class="key-toggle" bindtap="toggleAppSecret">
          <text>{{showAppSecret ? '🙈' : '👁'}}</text>
        </view>
      </view>
      <text class="key-hint">从微信公众平台获取</text>
    </view>
    
    <button class="save-btn" bindtap="saveWechatConfig">保存配置</button>
  </view>

  <!-- 通用设置 -->
  <view class="section-card card">
    <view class="section-header">
      <text class="section-icon">⚙️</text>
      <text class="section-title">通用设置</text>
    </view>
    
    <view class="toggle-setting">
      <view class="toggle-info">
        <text class="toggle-name">自动保存草稿</text>
        <text class="toggle-desc">编辑时自动保存到本地</text>
      </view>
      <switch checked="{{autoSave}}" bindchange="toggleAutoSave" color="#07c160"/>
    </view>
  </view>

  <!-- 账户操作 -->
  <view wx:if="{{userInfo}}" class="section-card card">
    <view class="section-header">
      <text class="section-icon">👤</text>
      <text class="section-title">账户</text>
    </view>
    
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text class="version-text">WeChat AI Publisher v1.3.0</text>
    <text class="version-text">小程序版</text>
  </view>
</view>
