/* pages/settings/settings.wxss */

.container {
  padding: 20rpx;
  padding-bottom: 60rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 用户卡片 */
.user-card {
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar.guest {
  background: rgba(255, 255, 255, 0.2);
}

.avatar-text {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
}

.user-details {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.user-email {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.user-role {
  margin-top: 8rpx;
}

.role-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 22rpx;
  border-radius: 16rpx;
}

.user-quota {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
}

.quota-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.quota-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.login-btn {
  margin-top: 12rpx;
  padding: 12rpx 32rpx;
  background: #fff;
  color: #07c160;
  font-size: 26rpx;
  border-radius: 24rpx;
  border: none;
  line-height: 1.4;
}

.login-btn::after {
  border: none;
}

/* 设置区块 */
.section-card {
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

/* 设置项 */
.setting-item {
  margin-bottom: 16rpx;
}

.setting-label {
  font-size: 26rpx;
  color: #666;
}

/* AI提供商列表 */
.provider-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.provider-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.provider-item.active {
  background: #e6f7ee;
  border-color: #07c160;
}

.provider-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid #ddd;
  box-sizing: border-box;
}

.provider-radio.checked {
  border-color: #07c160;
  background: #07c160;
  position: relative;
}

.provider-radio.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  background: #fff;
  border-radius: 50%;
}

.provider-info {
  flex: 1;
}

.provider-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.provider-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 密钥输入 */
.key-input-group {
  margin-bottom: 24rpx;
}

.key-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.key-input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  overflow: hidden;
}

.key-input {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  font-family: monospace;
}

.key-toggle {
  padding: 24rpx;
  font-size: 32rpx;
}

.key-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 开关设置 */
.toggle-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}

.toggle-info {
  flex: 1;
}

.toggle-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.toggle-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 按钮 */
.save-btn {
  width: 100%;
  padding: 24rpx;
  background: #333;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  margin-top: 16rpx;
}

.save-btn::after {
  border: none;
}

.test-btn {
  width: 100%;
  padding: 24rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  margin-top: 16rpx;
}

.test-btn::after {
  border: none;
}

.logout-btn {
  width: 100%;
  padding: 24rpx;
  background: #fff;
  color: #fa5151;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: 2rpx solid #fa5151;
}

.logout-btn::after {
  border: none;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 0;
}

.version-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}
