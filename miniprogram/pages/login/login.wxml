<!--pages/login/login.wxml-->
<!-- 登录页面 - 模仿真实web界面 -->

<view class="container">
  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo-icon-wrapper">
      <text class="logo-icon">📄</text>
    </view>
    <view class="logo-title">
      <text class="title-wechat">WeChat</text>
      <text class="title-ai">AI Publisher</text>
    </view>
    <text class="logo-subtitle">{{isRegisterMode ? '创建新账户' : '登录您的账户'}}</text>
  </view>

  <!-- 登录表单卡片 -->
  <view class="auth-card">
    <!-- 用户名（仅注册时显示） -->
    <view wx:if="{{isRegisterMode}}" class="form-field">
      <text class="field-label">用户名</text>
      <view class="input-wrapper">
        <text class="input-icon">👤</text>
        <input 
          class="field-input" 
          placeholder="输入您的用户名"
          value="{{name}}"
          bindinput="onNameInput"
          bindtap="triggerWechatLogin"
        />
      </view>
    </view>

    <!-- 邮箱地址 -->
    <view class="form-field">
      <text class="field-label">邮箱地址</text>
      <view class="input-wrapper">
        <text class="input-icon">📧</text>
        <input 
          class="field-input" 
          type="text"
          placeholder="your@email.com"
          value="{{email}}"
          bindinput="onEmailInput"
          bindtap="triggerWechatLogin"
        />
      </view>
    </view>

    <!-- 密码 -->
    <view class="form-field">
      <text class="field-label">密码</text>
      <view class="input-wrapper">
        <text class="input-icon">🔒</text>
        <input 
          class="field-input password-input" 
          type="{{showPassword ? 'text' : 'password'}}"
          placeholder="至少6个字符"
          value="{{password}}"
          bindinput="onPasswordInput"
          bindtap="triggerWechatLogin"
        />
        <view class="password-toggle" catchtap="togglePassword">
          <text>{{showPassword ? '🙈' : '👁'}}</text>
        </view>
      </view>
    </view>

    <!-- 确认密码（仅注册时显示） -->
    <view wx:if="{{isRegisterMode}}" class="form-field">
      <text class="field-label">确认密码</text>
      <view class="input-wrapper">
        <text class="input-icon">🔐</text>
        <input 
          class="field-input" 
          type="password"
          placeholder="再次输入密码"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
          bindtap="triggerWechatLogin"
        />
      </view>
    </view>

    <!-- 错误提示 -->
    <view wx:if="{{errorMsg}}" class="error-box">
      <text class="error-icon">⚠️</text>
      <text class="error-text">{{errorMsg}}</text>
    </view>

    <!-- 登录/注册按钮 -->
    <button 
      class="submit-btn" 
      bindtap="triggerWechatLogin"
      disabled="{{loading}}"
    >
      <view wx:if="{{loading}}" class="loading-spinner"></view>
      <block wx:else>
        <text class="btn-icon">{{isRegisterMode ? '➕' : '🚀'}}</text>
        <text>{{isRegisterMode ? '注册' : '登录'}}</text>
      </block>
    </button>

    <!-- 分隔线 -->
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">或者</text>
      <view class="divider-line"></view>
    </view>

    <!-- 切换登录/注册 -->
    <view class="switch-mode">
      <text class="switch-text">{{isRegisterMode ? '已有账户？' : '还没有账户？'}}</text>
      <text class="switch-link" bindtap="switchMode">
        {{isRegisterMode ? '立即登录' : '立即注册'}}
      </text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="footer-version">
    <text>WeChat AI Publisher v1.3.0</text>
  </view>
</view>
