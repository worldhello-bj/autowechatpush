<!--pages/login/login.wxml-->
<!-- 登录页面 - 外观与主界面完全一致，但所有按钮触发微信登录 -->

<view class="container">
  <!-- 顶部状态栏 -->
  <view class="header-card card">
    <view class="flex items-center justify-between">
      <view>
        <text class="title-md">AI文章生成器</text>
        <view class="flex items-center gap-sm mt-sm">
          <view class="status-dot bg-blue"></view>
          <text class="text-muted">DeepSeek</text>
        </view>
      </view>
      <view class="flex gap-sm">
        <button class="icon-btn" bindtap="triggerLogin">
          <text class="icon-text">📝</text>
        </button>
        <button class="icon-btn" bindtap="triggerLogin">
          <text class="icon-text">⚙️</text>
        </button>
        <button class="icon-btn" bindtap="triggerLogin">
          <text class="icon-text">💾</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 模式切换 -->
  <view class="mode-switcher card">
    <view class="flex">
      <view class="mode-btn active" bindtap="triggerLogin">
        <text class="mode-icon">✨</text>
        <text>创建新文章</text>
      </view>
      <view class="mode-btn" bindtap="triggerLogin">
        <text class="mode-icon">🎨</text>
        <text>格式化文本</text>
      </view>
    </view>
  </view>

  <!-- 输入区域 -->
  <view class="input-section card">
    <view class="label">主题/提示词</view>
    <textarea 
      class="textarea-field"
      placeholder="例如：写一篇关于秋季京都旅行的指南..."
      bindtap="triggerLogin"
      bindfocus="triggerLogin"
      disabled="{{loading}}"
    />
    
    <!-- 选项开关 -->
    <view class="options-row flex flex-wrap gap-sm mt-md">
      <!-- 网络搜索 -->
      <view class="option-chip disabled" bindtap="triggerLogin">
        <text class="option-icon">🔍</text>
        <text>网络搜索</text>
      </view>
      
      <!-- 双AI模式 (暂不可用) -->
      <view class="option-chip disabled" bindtap="triggerLogin">
        <text class="option-icon">🧠</text>
        <text>双AI模式 (暂不可用)</text>
      </view>
    </view>
  </view>

  <!-- 图片上传 -->
  <view class="upload-section card" bindtap="triggerLogin">
    <view class="upload-placeholder">
      <text class="upload-icon">📷</text>
      <text class="upload-text">上传图片（封面）</text>
    </view>
  </view>

  <!-- 生成按钮 -->
  <button 
    class="generate-btn primary-btn"
    bindtap="triggerLogin"
    disabled="{{loading}}"
  >
    <view wx:if="{{loading}}" class="loading-spinner"></view>
    <block wx:else>
      <text class="btn-icon">✨</text>
      <text>生成文章</text>
    </block>
  </button>

  <!-- 底部工具栏 -->
  <view class="bottom-toolbar card">
    <view class="toolbar-btn" bindtap="triggerLogin">
      <text class="toolbar-icon">📁</text>
      <text>素材库</text>
    </view>
    <view class="toolbar-btn" bindtap="triggerLogin">
      <text class="toolbar-icon">🤖</text>
      <text>AI工具</text>
    </view>
    <view class="toolbar-btn" bindtap="triggerLogin">
      <text class="toolbar-icon">🎨</text>
      <text>模板库</text>
    </view>
  </view>

  <!-- 登录提示浮层 -->
  <view class="login-hint-overlay" wx:if="{{showLoginHint}}">
    <view class="login-hint-card">
      <view class="hint-icon">🔐</view>
      <text class="hint-title">需要登录</text>
      <text class="hint-desc">使用微信登录后即可使用全部功能</text>
      <button class="wechat-login-btn" bindtap="handleWechatLogin" disabled="{{loading}}">
        <view wx:if="{{loading}}" class="loading-spinner white"></view>
        <block wx:else>
          <text class="wechat-icon">💬</text>
          <text>微信一键登录</text>
        </block>
      </button>
      <view class="hint-close" bindtap="hideLoginHint">暂不登录</view>
    </view>
  </view>
</view>
