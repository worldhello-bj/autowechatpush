/* pages/login/login.wxss */
/* 模仿真实web界面的登录页面样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 50%, #f0fdf4 100%);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: 0 20rpx 50rpx rgba(34, 197, 94, 0.3);
}

.logo-icon {
  font-size: 56rpx;
}

.logo-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.title-wechat {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2937;
}

.title-ai {
  font-size: 40rpx;
  font-weight: bold;
  color: #22c55e;
}

.logo-subtitle {
  font-size: 28rpx;
  color: #6b7280;
}

/* 登录表单卡片 */
.auth-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx;
  box-shadow: 0 25rpx 50rpx -12rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid rgba(0, 0, 0, 0.05);
}

/* 表单字段 */
.form-field {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 12rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #fff;
  border: 2rpx solid #d1d5db;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
  transition: all 0.2s;
}

.input-wrapper:focus-within {
  border-color: #22c55e;
  box-shadow: 0 0 0 4rpx rgba(34, 197, 94, 0.2);
}

.input-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.field-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #1f2937;
}

.password-input {
  flex: 1;
}

.password-toggle {
  padding: 16rpx;
  font-size: 32rpx;
}

/* 错误提示 */
.error-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.error-icon {
  font-size: 28rpx;
}

.error-text {
  font-size: 26rpx;
  color: #dc2626;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 16rpx 40rpx rgba(34, 197, 94, 0.3);
  margin-bottom: 40rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.btn-icon {
  font-size: 32rpx;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: #e5e7eb;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #9ca3af;
}

/* 切换模式 */
.switch-mode {
  text-align: center;
}

.switch-text {
  font-size: 26rpx;
  color: #4b5563;
}

.switch-link {
  font-size: 26rpx;
  color: #22c55e;
  font-weight: 500;
  margin-left: 8rpx;
}

/* 版本信息 */
.footer-version {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 加载动画 */
.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
